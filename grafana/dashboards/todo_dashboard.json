{
  "annotations": { "list": [] },
  "description": "Simple dashboard for To-Do app: request rate, latency, and errors",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": null,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "id": 2,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["last"], "fields": "", "values": true }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "pluginVersion": "9.0.0",
      "targets": [
        {
          "expr": "sum(rate(todo_app_http_requests_total[1m]))",
          "format": "time_series",
          "legendFormat": "all",
          "interval": "",
          "instant": false
        }
      ],
      "title": "Total request rate (rps)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 6 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(todo_app_http_request_duration_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "title": "P95 request latency by endpoint (s)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(todo_app_http_errors_total[5m])) by (endpoint)",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "title": "Error rate (5m) by endpoint",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 30,
  "style": "dark",
  "tags": ["todo", "app"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "To-Do App Overview",
  "uid": null,
  "version": 1
}
